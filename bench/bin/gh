#!/bin/sh
# agent-loop bench: the fake gh (bench/fake-gh.js). Put this directory first on PATH, with BENCH_STATE set.
# physical paths: follow a symlinked $0, then a symlinked directory, so node sees the real fake-gh.js
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
exec node "$dir/../fake-gh.js" "$@"
